        <item>log I am going to eat $meal</item>
        <item>log I\'m going to eat $meal</item>
        <item>I ate $meal</item>
        <item>I am going to eat $meal</item>
        <item>I\'m going to eat $meal</item>
        <item>record $meal</item>
        <item>track $meal</item>
        <item>add $meal</item>
        <item>add a meal of $meal</item>
        <item>add a meal $meal</item>
        <item>add $meal to my food log</item>
        <item>add $meal to logger</item>
        <item>add $meal to my diary</item>
    </string-array>
