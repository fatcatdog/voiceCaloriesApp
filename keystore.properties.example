# Copy this file to keystore.properties, then fill in the real values.
# Never commit keystore.properties or the upload-keystore.jks file.
#
# If you do not remember the key alias, run:
#   keytool -list -keystore upload-keystore.jks
#
# storeFile can be absolute or relative to the project root.
storeFile=upload-keystore.jks
storePassword=YOUR_KEYSTORE_PASSWORD
keyAlias=upload
keyPassword=YOUR_KEY_PASSWORD
